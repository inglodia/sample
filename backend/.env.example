# Copy to backend/.env for local development (never commit .env).
# If root docker-compose maps Postgres to a port other than 5432, set DATABASE_URL to match
# (see root POSTGRES_PORT in the repo .env file).

DATABASE_URL=postgresql+psycopg://portal:portal@127.0.0.1:5432/portal
SESSION_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173
