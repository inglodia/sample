# Copy to backend/.env for local development (never commit .env).
#
# IMPORTANT — keep DATABASE_URL host port in sync with root .env POSTGRES_PORT:
# docker-compose publishes Postgres as 127.0.0.1:${POSTGRES_PORT} on the host.
# Example: if root .env has POSTGRES_PORT=5434, use ...@127.0.0.1:5434/portal below.
# Default compose mapping uses 5432 when POSTGRES_PORT is unset.

DATABASE_URL=postgresql+psycopg://portal:portal@127.0.0.1:5432/portal
SESSION_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Test@1234
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
